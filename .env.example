# Template only — NO REAL KEYS IN THIS FILE. It is committed to git.
# Copy to .env.local (gitignored) and fill in there.

# Primary LLM: Gemini 2.5 Flash (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Fallback LLM: Groq / Llama (https://console.groq.com/keys)
# Optional in Phase 0 — if unset, the fallback is skipped and Gemini's error surfaces.
GROQ_API_KEY=
# gpt-oss models get strict json_schema enforcement + reasoning_effort.
# Llama models (e.g. llama-3.3-70b-versatile) fall back to json_object mode
# automatically — the code detects this from the model id.
GROQ_MODEL=openai/gpt-oss-120b

# low | medium | high. Only used for gpt-oss models.
GROQ_REASONING_EFFORT=medium

# Testing only: "true" skips Gemini entirely and goes straight to the fallback.
# Leave unset in production.
FORCE_FALLBACK=

# Quiz cache (any PostgreSQL, e.g. Supabase/Neon free tier).
# OPTIONAL: leave unset and the app runs statelessly, generating every time.
# Run `npm run migrate` once after setting this to create the quizzes table.
DATABASE_URL=
